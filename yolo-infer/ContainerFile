# yolo-infer/Containerfile
#
# Swappable inference workload #1.
# Reads /dev/video0, runs YOLOv8 (TensorRT engine), publishes annotated
# frames to MediaMTX at rtsp://127.0.0.1:8554/infer.
#
# Contract (shared with traffic-infer):
#   INPUT:  /dev/video0 (V4L2)
#   OUTPUT: rtsp://127.0.0.1:8554/infer (H.264 over RTSP/TCP)
#   MODELS: /models (read-only, populated by model-init container)
#
# IMPORTANT: BASE_IMAGE must match the tag used by model-init/ exactly.
# A mismatch causes TRT engine deserialization failures at startup.

ARG BASE_IMAGE=nvcr.io/nvidia/l4t-ml:r36.2.0-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# OS deps:
# - ffmpeg:       frame encode + RTSP publish (NVENC path preferred at runtime)
# - v4l-utils:    v4l2-ctl for camera debugging inside the container
# - libglib2.0-0, libgl1: OpenCV runtime deps (usually present, harmless if so)
# - tini:         PID 1 that reaps zombies and forwards signals cleanly to python
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      v4l-utils \
      ca-certificates \
      libglib2.0-0 \
      libgl1 \
      tini \
    && rm -rf /var/lib/apt/lists/*

# Python deps.
# --no-deps on ultralytics so we DON'T clobber the Jetson-tuned torch that
# ships in l4t-ml with a generic CPU-only ARM64 wheel from PyPI.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir --no-deps ultralytics && \
    python3 -m pip install