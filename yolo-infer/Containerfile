ARG BASE_IMAGE=nvcr.io/nvidia/l4t-ml:r36.2.0-py3
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg v4l-utils ca-certificates libglib2.0-0 libgl1 tini \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir --no-deps ultralytics && \
    python3 -m pip install --no-cache-dir \
      'numpy<2' pyyaml tqdm requests psutil pandas matplotlib seaborn py-cpuinfo

WORKDIR /app
COPY infer_stream_rtsp.py /app/infer_stream_rtsp.py
RUN chmod +x /app/infer_stream_rtsp.py

ENV RTSP_URL="rtsp://127.0.0.1:8554/infer" SRC="/dev/video0" \
    MODEL="/models/yolov8n.engine" FALLBACK_MODEL="/models/yolov8n.pt" \
    W="1280" H="720" FPS="10" CAP_FOURCC="YUYV" \
    BITRATE="2500k" ENCODER="auto" CAM_FAIL_THRESHOLD="30"

VOLUME ["/models"]
ENTRYPOINT ["/usr/bin/tini", "--", "python3", "/app/infer_stream_rtsp.py"]